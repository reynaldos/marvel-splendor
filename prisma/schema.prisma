generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameStatus {
  LOBBY
  ACTIVE
  FINISHED
  ABANDONED
}

enum GameMode {
  VS_BOT
  MULTIPLAYER
}

enum ChatKind {
  TEXT
  REACTION
}

model User {
  id               String            @id @default(cuid())
  auth0Sub         String            @unique
  username         String            @unique
  name             String?
  // As last seen at sign-in. Not unique: one person can sign in more than one way.
  email            String?
  // An uploaded picture's storage key, or "library/<id>" for one from the library.
  avatarKey        String?
  // Whether the account-level frame is drawn on their picture, and on the card that carries their name.
  xpAvatarStyle    Boolean           @default(false)
  xpCardStyle      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  players          GamePlayer[]
  stats            UserStats?
  visits           UserVisit[]
  collected        CollectedCard[]
  rating           UserRating?
  coins            UserCoins?
  coinTransactions CoinTransaction[]
}

// A card a player has recruited themselves, in a game played to the end.
model CollectedCard {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId       String
  times        Int      @default(1)
  firstFoundAt DateTime @default(now())

  @@id([userId, cardId])
}

// One stretch of activity from one IP address; a 30 minute gap starts a new one.
model UserVisit {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId, lastSeenAt])
}

model UserStats {
  userId           String @id
  user             User   @relation(fields: [userId], references: [id])
  gamesPlayed      Int    @default(0)
  wins             Int    @default(0)
  vsBotWins        Int    @default(0)
  bestPoints       Int    @default(0)
  fastestWinTurns  Int?
  avengersTilesWon Int    @default(0)
  locationsClaimed Int    @default(0)
}

// An ELO-style rank, from multiplayer games with another human only. No season or decay:
// it only moves when a rated game finishes.
model UserRating {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id])
  rating     Int      @default(1000)
  gamesRated Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// Cached balance for fast reads — CoinTransaction below is the source of truth.
model UserCoins {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id])
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

// One award (or future spend) of coins. reason is "game:<opponentTier>:<win|loss>" for
// now, e.g. "game:human:win" or "game:hard:loss"; a shop spend will add its own reasons later.
model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  gameId    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Game {
  id         String        @id @default(cuid())
  joinCode   String        @unique
  status     GameStatus    @default(LOBBY)
  mode       GameMode
  seed       String
  settings   Json
  state      Json
  version    Int           @default(0)
  winnerSeat Int?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  players    GamePlayer[]
  moves      Move[]
  messages   ChatMessage[]
}

model GamePlayer {
  id         String  @id @default(cuid())
  gameId     String
  game       Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seat       Int
  userId     String?
  user       User?   @relation(fields: [userId], references: [id])
  guestName  String?
  isBot      Boolean @default(false)
  guestToken String?

  @@unique([gameId, seat])
  @@index([userId])
}

model Move {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ordinal   Int
  seat      Int
  payload   Json
  createdAt DateTime @default(now())

  @@unique([gameId, ordinal])
}

model ChatMessage {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  seat      Int
  kind      ChatKind
  body      String
  createdAt DateTime @default(now())

  @@index([gameId, createdAt])
}
