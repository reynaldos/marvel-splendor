# --- Database (Neon Postgres) ---
# Neon dashboard -> your project -> Connection Details -> "Pooled connection" string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Auth0 ---
# Auth0 dashboard -> Applications -> your app (Regular Web Application)
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
# Generate with: openssl rand -hex 32
AUTH0_SECRET=""
# Local dev: http://localhost:3000 — on Vercel: your production URL
APP_BASE_URL="http://localhost:3000"

# --- Admin ---
# Who may open /admin/users: emails separated by commas. Empty means nobody.
ADMIN_EMAILS=
# Usernames kept off the leaderboard, separated by commas. Empty hides nobody.
LEADERBOARD_HIDDEN=

# --- Cloudflare R2 (avatars) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="marvel-splendor-avatars"
# Public base URL for the bucket (R2 public dev URL or custom domain), no trailing slash
R2_PUBLIC_BASE_URL=""

# --- OpenAI (bot banter, squad pic demo) ---
OPENAI_API_KEY=""
# --- fal.ai (squad pic demo, FLUX.2) ---
FAL_KEY=""
# --- ComfyUI (squad pic demo); left out, the one on this machine is used ---
COMFY_URL="http://127.0.0.1:8188"
# Optional: disable banter without removing the key
BANTER_ENABLED="true"

# --- Pusher Channels (live multiplayer sync) ---
# Pusher dashboard -> your app -> App Keys
PUSHER_APP_ID=""
PUSHER_SECRET=""
# Safe to expose to the browser
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us2"
