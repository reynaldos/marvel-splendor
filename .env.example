# --- Database (Neon Postgres) ---
# Neon dashboard -> your project -> Connection Details -> "Pooled connection" string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Auth0 ---
# Auth0 dashboard -> Applications -> your app (Regular Web Application)
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
# Generate with: openssl rand -hex 32
AUTH0_SECRET=""
# Local dev: http://localhost:3000 — on Vercel: your production URL
APP_BASE_URL="http://localhost:3000"

# --- Cloudflare R2 (avatars) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="marvel-splendor-avatars"
# Public base URL for the bucket (R2 public dev URL or custom domain), no trailing slash
R2_PUBLIC_BASE_URL=""

# --- OpenAI (bot banter) ---
OPENAI_API_KEY=""
# Optional: disable banter without removing the key
BANTER_ENABLED="true"
