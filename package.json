{
  "name": "marvel-splendor",
  "version": "2.6.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "images": "node scripts/image-versions.mjs",
    "dev": "node scripts/image-versions.mjs && next dev",
    "build": "node scripts/image-versions.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "games:clear": "node scripts/clear-games.mjs",
    "games:reset": "node scripts/clear-games.mjs --stats",
    "db:update": "prisma db push && prisma generate",
    "collection:backfill": "npx tsx scripts/backfill-collection.ts",
    "rating:backfill": "npx tsx scripts/backfill-rating.ts",
    "coins:backfill": "npx tsx scripts/backfill-coins.ts",
    "rewards:backfill": "npx tsx scripts/backfill-rewards.ts",
    "visits:backfill": "npx tsx scripts/backfill-visits.ts",
    "xp:lab": "npx tsx scripts/export-xp-lab.ts",
    "daily:backfill": "npx tsx scripts/backfill-daily-bonus.ts",
    "launch:images": "node scripts/launch-images.mjs"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.30.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "openai": "^7.23.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
