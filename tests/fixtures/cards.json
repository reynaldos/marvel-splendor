  "_meta": {
    "source": "Base Splendor 90-card table from bouk/splendimax 'Splendor Cards.csv' (github.com/bouk/splendimax), cross-verified card-for-card against seal256/splendor 'assets/cards.csv' (github.com/seal256/splendor). Gem-to-stone mapping: diamond/white->mind, sapphire/blue->space, emerald/green->soul, ruby/red->reality, onyx/black->power.",
    "tagRule": "Level 1: tag=1 on the five 1-point cards, else 0. Level 3: tag=2 on 5-point cards, tag=1 on 4-point cards, 0 on 3-point cards. Level 2: all 0 -- the base list has fifteen 2-point level-2 cards, so tagging them (as a naive points-based rule would) yields 40 tags; dropping level-2 tags lands the deck at exactly 25 total Avengers tags, within the ~20-25 target.",
    "names": "Placeholder names: real Marvel characters, NOT matched card-for-card to the physical deck. Avengers names sit on tagged cards.",
    "note": "costs mirror base Splendor pending verification against physical Marvel copy"
  },
